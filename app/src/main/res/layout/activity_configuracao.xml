<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tituloConfiguracaoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_configuracao"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/duracaoFocoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_duracao_foco"
        app:layout_constraintTop_toBottomOf="@id/tituloConfiguracaoText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"/>

    <SeekBar
        android:id="@+id/duracaoFocoSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:min="1"
        android:max="60"
        android:progress="25"
        app:layout_constraintTop_toBottomOf="@id/duracaoFocoLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/duracaoPausaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/duracao_pausa_curta"
        app:layout_constraintTop_toBottomOf="@id/duracaoFocoSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <SeekBar
        android:id="@+id/duracaoPausaSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:min="1"
        android:max="30"
        android:progress="5"
        app:layout_constraintTop_toBottomOf="@id/duracaoPausaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/somAtivadoSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_som_ativado"
        android:checked="true"
        app:layout_constraintTop_toBottomOf="@id/duracaoPausaSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>
    <TextView
        android:id="@+id/ciclosLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_ciclos"
        app:layout_constraintTop_toBottomOf="@id/somAtivadoSwitch"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <Spinner
        android:id="@+id/ciclosSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:entries="@array/opcoes_ciclos"
        app:layout_constraintTop_toBottomOf="@id/ciclosLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/progressoCicloLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_progresso_ciclo"
        app:layout_constraintTop_toBottomOf="@id/ciclosSpinner"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <ProgressBar
        android:id="@+id/progressoCicloBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        app:layout_constraintTop_toBottomOf="@id/progressoCicloLabel"
        app:layout_constraintBottom_toTopOf="@id/salvarConfiguracaoButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/salvarConfiguracaoButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_salvar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>